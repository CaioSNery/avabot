{
  "Portal": {
    "Url": "https://login.unime.edu.br/?mCode=no_session",
    "Login": "",
    "Senha": ""
  },
  "Ava": {
    "Login": "",
    "Senha": ""
  },
  "OpenAI": {
    "ApiKey": "",
    "PrimaryModel": "gpt-5-mini",
    "FallbackModel": "gpt-5",
    "FallbackConfidenceThreshold": 0.75,
    "EnableConsoleInference": true,
    "Temperature": 0,
    "MaxOutputTokens": 4096,
    "ReasoningEffort": "minimal",
    "RequestTimeoutSeconds": 300,
    "RetryCount": 2
  },
  "ActivityNavigation": {
    "Mode": "Completo"
  },
  "ActivityDiscovery": {
    "CompletionRenderDelay": 5000
  },
  "QuizSubmission": {
    "Enabled": true,
    "ManualCompletionTimeout": 1800000
  },
  "ManualQuizNavigation": {
    "Enabled": true,
    "AnswerTimeout": 0,
    "MaxPages": 50
  },
  "AnswerFill": {
    "QuestionSelector": ".que, [data-testid='question'], [data-question-id], .question",
    "QuestionNumberSelector": "[data-testid='question-number'], .qno, .info .no, .question-number",
    "AlternativeSelector": "[data-testid='alternative'], .answer label, .alternative, .option",
    "QuestionNavigationSelector": "a.qnbutton[href], [data-testid='question-navigation'] a[href]",
    "NextPageSelector": "input.mod_quiz-next-nav[type='submit'], button.mod_quiz-next-nav, input[name='next'][type='submit'], button[name='next'], input[type='submit'][value*='Próxima' i], button:has-text('Próxima página')",
    "ClickTimeout": 10000,
    "ManualAnswerTimeout": 30000,
    "MinimumConfidence": 0.55,
    "DryRun": false
  },
  "DidacticBook": {
    "Enabled": true,
    "CompletionRenderDelay": 5000,
    "VisitDuration": 3000
  },
  "Browser": {
    "Headless": false,
    "Timeout": 30000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/avabot-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "AvaBot"
    }
  }
}